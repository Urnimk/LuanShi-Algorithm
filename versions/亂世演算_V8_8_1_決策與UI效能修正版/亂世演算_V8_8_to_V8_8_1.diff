+    def _read_text_cached(self, path):
+        """依 mtime/size/inode 快取文字檔；變更前不重新開檔。"""
+        stat = os.stat(path)
+        signature = (stat.st_mtime_ns, stat.st_ctime_ns, stat.st_size, stat.st_ino)
+        entry = self._text_file_cache.get(path)
+        if entry is not None and entry[0] == signature:
+            return entry[1]
+        with open(path, "r", encoding="utf-8") as handle:
+            value = handle.read()
+        self._text_file_cache[path] = (signature, value)
+        return value
+
+    def _sync_overview_rows(self, tree, keyed_rows, iid_prefix):
+        """以穩定 key 增量新增、刪除、更新 overview 列。"""
+        desired = [(f"{iid_prefix}{key}", tuple(row)) for key, row in keyed_rows]
+        desired_ids = {iid for iid, _row in desired}
+        for iid in tree.get_children(""):
+            if iid not in desired_ids:
+                tree.delete(iid)
+        for iid, row in desired:
+            if tree.exists(iid):
+                old_values = tuple(tree.item(iid, "values"))
+                if old_values != row:
+                    tree.item(iid, values=row)
+            else:
+                tree.insert("", "end", iid=iid, values=row)
